:root{
  --forest:#0d3426;
  --forest2:#17533b;
  --green:#287453;
  --gold:#d6b65d;
  --cream:#f4f0e5;
  --white:#fff;
  --text:#17241d;
  --muted:#6e786f;
  --border:#e1e5df;
  --danger:#a93434;
  --shadow:0 12px 35px rgba(13,52,38,.12);
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7f4;
  color:var(--text);
}

button,input,select{font:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}

.hidden{display:none!important}

.topbar{
  height:72px;
  background:var(--forest);
  color:white;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 5%;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  font-size:25px;
  font-weight:900;
  letter-spacing:3px;
}
.logo span{color:var(--gold)}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.btn{
  border:0;
  padding:12px 18px;
  border-radius:10px;
  font-weight:700;
}

.btn-green{
  background:var(--green);
  color:white;
}

.btn-gold{
  background:var(--gold);
  color:#183024;
}

.btn-light{
  background:#edf2ee;
  color:var(--forest);
}

.btn-danger{
  background:#fee8e8;
  color:var(--danger);
}

.layout{
  display:grid;
  grid-template-columns:230px 1fr;
  min-height:calc(100vh - 72px);
}

.sidebar{
  background:#102f24;
  color:white;
  padding:25px 15px;
}

.navbtn{
  width:100%;
  padding:13px 15px;
  margin-bottom:7px;
  border:0;
  background:transparent;
  color:#dce8e1;
  text-align:left;
  border-radius:10px;
}

.navbtn:hover,.navbtn.active{
  background:#235842;
  color:white;
}

.main{
  padding:30px;
  max-width:1400px;
  width:100%;
}

.eyebrow{
  color:#a07c22;
  font-weight:800;
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:1px;
}

h1{margin:8px 0 5px}
h2{margin:10px 0}
.muted{color:var(--muted)}

.hero{
  border-radius:20px;
  min-height:230px;
  padding:38px;
  color:white;
  display:flex;
  align-items:center;
  background:
    linear-gradient(90deg,rgba(8,42,29,.97),rgba(22,91,62,.77)),
    linear-gradient(135deg,#153d2e,#337455);
  box-shadow:var(--shadow);
}

.hero-content{max-width:650px}
.hero h1{font-size:39px}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
  margin:20px 0;
}

.stat{
  background:white;
  padding:20px;
  border-radius:15px;
  box-shadow:var(--shadow);
}

.stat-label{
  color:var(--muted);
  font-size:12px;
  font-weight:800;
}

.stat-value{
  font-size:27px;
  font-weight:900;
  margin-top:7px;
  color:var(--forest);
}

.package-section{
  margin-top:35px;
}

.package-head{
  margin-bottom:14px;
}

.package-banner{
  height:150px;
  border-radius:17px;
  padding:25px;
  display:flex;
  align-items:flex-end;
  color:white;
  margin-bottom:15px;
  box-shadow:var(--shadow);
}

.starter{
  background:
    linear-gradient(rgba(10,45,31,.4),rgba(10,45,31,.88)),
    linear-gradient(135deg,#5e875e,#173e2d);
}

.growth{
  background:
    linear-gradient(rgba(8,43,30,.35),rgba(8,43,30,.9)),
    linear-gradient(135deg,#7aa070,#184b34);
}

.builder{
  background:
    linear-gradient(rgba(8,43,30,.3),rgba(8,43,30,.9)),
    linear-gradient(135deg,#946e3e,#254f36);
}

.partner{
  background:
    linear-gradient(rgba(8,43,30,.35),rgba(8,43,30,.92)),
    linear-gradient(135deg,#506c44,#153a2b);
}

.premium{
  background:
    linear-gradient(rgba(8,43,30,.3),rgba(8,43,30,.92)),
    linear-gradient(135deg,#b39145,#193c2d);
}

.package-banner h2{
  margin:0;
  font-size:28px;
}

.phase-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.phase-card{
  background:white;
  border-radius:15px;
  overflow:hidden;
  box-shadow:var(--shadow);
  border:1px solid var(--border);
}

.phase-img{
  height:95px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42px;
  background:linear-gradient(135deg,#dfece3,#a8c8ae);
}

.phase-body{
  padding:17px;
}

.phase-title{
  font-weight:900;
  color:var(--forest);
}

.phase-price{
  font-size:24px;
  font-weight:900;
  margin:8px 0;
}

.phase-meta{
  color:var(--muted);
  font-size:13px;
  margin-bottom:13px;
}

.card{
  background:white;
  border-radius:16px;
  padding:22px;
  box-shadow:var(--shadow);
  margin-top:20px;
}

.table-wrap{overflow:auto}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  padding:13px;
  border-bottom:1px solid var(--border);
  text-align:left;
  white-space:nowrap;
}

th{
  font-size:12px;
  color:var(--muted);
}

